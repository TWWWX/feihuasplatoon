{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null && $roomId.length === 6 && $roomId.matches(/^[A-Z0-9]{6}$/) && (!data.exists() || data.child('players/red/uid').val() === auth.uid || data.child('players/blue/uid').val() === auth.uid)",
        ".write": "auth != null && $roomId.length === 6 && $roomId.matches(/^[A-Z0-9]{6}$/) && (!data.exists() || data.child('meta/hostUid').val() === auth.uid)",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || root.child('rooms/' + $roomId + '/meta/hostUid').val() === auth.uid || (newData.child('hostUid').val() === auth.uid && (root.child('rooms/' + $roomId + '/players/red/uid').val() === auth.uid || root.child('rooms/' + $roomId + '/players/blue/uid').val() === auth.uid) && (root.child('rooms/' + $roomId + '/players/red/uid').val() !== root.child('rooms/' + $roomId + '/meta/hostUid').val() || root.child('rooms/' + $roomId + '/players/blue/uid').val() !== root.child('rooms/' + $roomId + '/meta/hostUid').val() || (!root.child('rooms/' + $roomId + '/presence/red').exists() || root.child('rooms/' + $roomId + '/presence/red').val() < now - 600000) || (!root.child('rooms/' + $roomId + '/presence/blue').exists() || root.child('rooms/' + $roomId + '/presence/blue').val() < now - 600000))))",
          ".validate": "newData.hasChildren(['hostUid', 'createdAt'])",
          "hostUid": {
            ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 40"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "$other": { ".validate": false }
        },
        "players": {
          "red": {
            ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || (root.child('rooms/' + $roomId + '/players/blue/uid').val() === auth.uid && data.child('uid').val() !== auth.uid && (!root.child('rooms/' + $roomId + '/presence/red').exists() || root.child('rooms/' + $roomId + '/presence/red').val() < now - 600000)))",
            ".validate": "newData.hasChildren(['uid', 'name']) && newData.child('uid').val() === auth.uid",
            "uid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
            },
            "$other": { ".validate": false }
          },
          "blue": {
            ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || (root.child('rooms/' + $roomId + '/players/red/uid').val() === auth.uid && data.child('uid').val() !== auth.uid && (!root.child('rooms/' + $roomId + '/presence/blue').exists() || root.child('rooms/' + $roomId + '/presence/blue').val() < now - 600000)))",
            ".validate": "newData.hasChildren(['uid', 'name']) && newData.child('uid').val() === auth.uid",
            "uid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
            },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },
        "state": {
          ".write": "auth != null && (!data.exists() || root.child('rooms/' + $roomId + '/players/red/uid').val() === auth.uid || root.child('rooms/' + $roomId + '/players/blue/uid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['seed', 'side', 'totalRounds', 'endless', 'board', 'currentTurn', 'round', 'redScore', 'blueScore', 'status'])",
          "seed": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 2147483648"
          },
          "side": {
            ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 20"
          },
          "totalRounds": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
          },
          "endless": {
            ".validate": "newData.isBoolean()"
          },
          "poolMask": {
            ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 31)"
          },
          "board": {
            ".validate": "newData.hasChildren()",
            "$cell": {
              ".validate": "newData.hasChildren(['ch'])",
              "ch": {
                ".validate": "newData.isString() && newData.val().length === 1"
              },
              "owner": {
                ".validate": "newData.val() === 'red' || newData.val() === 'blue'"
              },
              "$other": { ".validate": false }
            }
          },
          "currentTurn": {
            ".validate": "newData.val() === 'red' || newData.val() === 'blue'"
          },
          "round": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999"
          },
          "redScore": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
          },
          "blueScore": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
          },
          "history": {
            "$entry": {
              ".validate": "newData.hasChildren(['type', 'team', 'round'])",
              "type": {
                ".validate": "newData.val() === 'fly' || newData.val() === 'pass'"
              },
              "team": {
                ".validate": "newData.val() === 'red' || newData.val() === 'blue'"
              },
              "round": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999"
              },
              "line": {
                ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 50)"
              },
              "norm": {
                ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 50)"
              },
              "raw": {
                ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 50)"
              },
              "hits": {
                ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000)"
              },
              "blank": {
                ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000)"
              },
              "capture": {
                ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000)"
              },
              "hold": {
                ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000)"
              },
              "cells": {
                ".validate": "!newData.exists() || newData.hasChildren()",
                "$cell": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
                }
              },
              "$other": { ".validate": false }
            }
          },
          "status": {
            ".validate": "newData.val() === 'ready' || newData.val() === 'playing' || newData.val() === 'over'"
          },
          "endReason": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 20)"
          },
          "$other": { ".validate": false }
        },
        "presence": {
          "red": {
            ".write": "auth != null && root.child('rooms/' + $roomId + '/players/red/uid').val() === auth.uid",
            ".validate": "!newData.exists() || newData.isNumber()"
          },
          "blue": {
            ".write": "auth != null && root.child('rooms/' + $roomId + '/players/blue/uid').val() === auth.uid",
            ".validate": "!newData.exists() || newData.isNumber()"
          },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
